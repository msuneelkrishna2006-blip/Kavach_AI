# KavachAI Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_QUOTA_PER_USER=25

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Auth
JWT_SECRET=generate_a_random_string_of_at_least_32_characters_here
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12
HASH_SALT=another_random_string_for_ip_and_reporter_hashing
